---
import { app } from '../content';
import StoreLink from '../components/StoreLink.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
}

const { title, description, path, eyebrow } = Astro.props;
const canonicalUrl = new URL(path, app.siteUrl).href;
const pageTitle = `${title} | ${app.name}`;
const theme = Object.entries(app.colors).map(([key, value]) => `--${key}:${value}`).join(';');
---
<!doctype html>
<html lang="en" style={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content={app.colors.background} />
    <link rel="icon" href={app.icon} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={app.name} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header">
      <a href="/" class="brand" aria-label={`${app.name} home`}>
        <img src={app.icon} alt="" width="32" height="32" />
        {app.name}
      </a>
      <nav aria-label="Main navigation">
        <a href="/#features">{app.navigation.features}</a>
        <a href="/#screens">{app.navigation.screens}</a>
        <a href="/#reviews">{app.navigation.reviews}</a>
      </nav>
      <StoreLink compact />
    </header>
    <main id="main" class="content-page wrap">
      <header class="content-heading">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </header>
      <article class="prose">
        <slot />
      </article>
    </main>
    <footer class="wrap">
      <div>
        <a class="brand" href="/"><img src={app.icon} alt="" width="26" height="26" />{app.name}</a>
        <p>{app.footer.text}</p>
      </div>
      <small>{app.footer.legal}</small>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/privacypolicy/">Privacy Policy</a>
        <a href="/changelog/">Changelog</a>
        <a href="/">Home</a>
      </nav>
    </footer>
  </body>
</html>
